# Copy to .env.local (git-ignored) for local development, and set the same keys in your host (e.g. Vercel).
# Never commit real values.

# Database for bookings, enquiries, customers and admin accounts. Any Postgres connection string
# (Neon or Supabase recommended). Leave empty in development to use the local embedded database
# in .data/pglite (created automatically; git-ignored).
DATABASE_URL=

# Email (new-request alerts, password links later). Any SMTP server, e.g. Amazon SES SMTP:
# host email-smtp.<region>.amazonaws.com, port 587, with SES *SMTP* credentials (not the API keys).
# Sender and recipients are set in Admin → Settings → Email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Media uploads (Admin → Media). Created automatically when you connect a Vercel Blob store to the
# project (Vercel → Storage → Create → Blob). Copy it into .env.local to import the old media library.
BLOB_READ_WRITE_TOKEN=

# Optional: also forward a copy of every new request to a webhook (Make/Zapier/CRM/email service)
# as a JSON POST. Requests are always saved to the database first, whether or not this is set.
ENQUIRY_WEBHOOK_URL=
